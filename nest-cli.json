{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "quotes/pdf/fonts/**/*.ttf",
        "outDir": "./dist"
      },
      {
        "include": "quotes/pdf/i18n/**/*.json",
        "outDir": "./dist"
      }
    ]
  }
}
